<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="SighBD" providerName="System.Data.SqlClient" connectionString="Data Source=localhost;Initial Catalog=sigh_gr01;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5;Application Name=SIGH SighDotNet"/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8"/>
    <compilation targetFramework="4.7.2" debug="true"/>
    <httpRuntime targetFramework="4.7.2" maxRequestLength="3072"/>
    <authentication mode="Forms">
      <forms name="SighUnificadoSesion" loginUrl="~/" timeout="20" slidingExpiration="false" cookieless="UseCookies" protection="All"/>
    </authentication>
    <httpCookies httpOnlyCookies="true"/>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" culture="neutral" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>